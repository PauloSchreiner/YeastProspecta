import os

configfile: "config.yaml"


INPUT_DIR = config["directories"]["inputs"]
SUMMARY_DIR = config["directories"]["summary"]

TRIM_DIR = config["directories"]["trim_fastq"]
TRIM_REPORT_DIR = config["directories"]["trim_reports"]

CONSENSUS_DIR = config["directories"]["consensus_fasta"]
CONSENSUS_REPORT_DIR = config["directories"]["consensus_reports"]

BLAST_RAW_DIR = config["directories"]["blast_raw"]

TRIM_CUTOFF = config["parameters"]["trim_cutoff"]

files = glob_wildcards(os.path.join(INPUT_DIR, "{sample}_{primer}.ab1"))
samples, primers = files.sample, files.primer

# Tokens that identify technical replicates
GROUPING_TOKENS = set(
    config.get("sample_grouping", {}).get("remove_tokens_for_consensus", [])
)

def canonical_sample(raw_sample):
    return "_".join(
        token for token in raw_sample.split("_")
        if token not in GROUPING_TOKENS
    )

# Group original sample names by their canonical name
sample_groups = {}

for raw_sample in sorted(set(samples)):
    canonical = canonical_sample(raw_sample)
    sample_groups.setdefault(canonical, []).append(raw_sample)

# Current implementation supports one or two original sample names per group
for canonical, sources in sample_groups.items():
    if len(sources) > 2:
        raise ValueError(
            f"{canonical}: found {len(sources)} grouped sample names. "
            "This implementation supports at most two."
        )

unique_samples = sorted(sample_groups)


rule all:
    input:
        trim_summary = os.path.join(SUMMARY_DIR, "trim_metrics.tsv"),
        consensus_summary = os.path.join(SUMMARY_DIR, "consensus_summary.tsv"),
        blast_summary = os.path.join(SUMMARY_DIR, "final_report.xlsx")


rule trim:
    input:
        os.path.join(INPUT_DIR, "{sample}_{primer}.ab1")
    output:
        fastq = os.path.join(TRIM_DIR, "{sample}_{primer}_trimmed.fastq"),
        report = os.path.join(TRIM_REPORT_DIR, "{sample}_{primer}_trim_report.tsv")
    params:
        cutoff = TRIM_CUTOFF
    shell:
        """
        python3 workflow/scripts/trim.py -i {input} -o {output.fastq} --output_report {output.report} --trim_cutoff {params.cutoff}
        """


rule trim_aggregate:
    input:
        reports = expand(os.path.join(TRIM_REPORT_DIR, "{sample}_{primer}_trim_report.tsv"), 
               zip, sample=samples, primer=primers)
    output:
        summary = os.path.join(SUMMARY_DIR, "trim_metrics.tsv")
    run:
        import pandas as pd
        dfs = [pd.read_csv(f, sep='\t') for f in input.reports]
        final_df = pd.concat(dfs, ignore_index=True)
        final_df.to_csv(output.summary, sep='\t', index=False)


rule merge_direction_replicates:
    input:
        first = lambda wc: os.path.join(
            TRIM_DIR,
            f"{sample_groups[wc.sample][0]}_{wc.primer}_trimmed.fastq"
        ),
        second = lambda wc: os.path.join(
            TRIM_DIR,
            f"{sample_groups[wc.sample][1]}_{wc.primer}_trimmed.fastq"
        )
    output:
        fasta = os.path.join(
            CONSENSUS_DIR,
            "{sample}_{primer}_replicate_consensus.fasta"
        ),
        report = os.path.join(
            CONSENSUS_REPORT_DIR,
            "{sample}_{primer}_replicate_report.txt"
        )
    wildcard_constraints:
        primer = "F|R"
    shell:
        """
        merger \
            -asequence {input.first} \
            -bsequence {input.second} \
            -outseq {output.fasta} \
            -outfile {output.report}
        """


def consensus_direction_input(wildcards, primer):
    sources = sample_groups[wildcards.sample]

    # Sample without technical replicates
    if len(sources) == 1:
        return os.path.join(
            TRIM_DIR,
            f"{sources[0]}_{primer}_trimmed.fastq"
        )

    # Sample with technical replicates
    elif len(sources) == 2:
        return os.path.join(
            CONSENSUS_DIR,
            f"{wildcards.sample}_{primer}_replicate_consensus.fasta"
        )

    else:
        raise ValueError(
            f"Unexpected number of source samples for {wildcards.sample}"
        )


rule consensus:
    input:
        F_read = lambda wc: consensus_direction_input(wc, "F"),
        R_read = lambda wc: consensus_direction_input(wc, "R")
    output:
        fasta = os.path.join(CONSENSUS_DIR, "{sample}_consensus.fasta"),
        report = os.path.join(CONSENSUS_REPORT_DIR, "{sample}_consensus_report.txt")
    shell:
        """
        merger \
            -asequence {input.F_read} \
            -bsequence {input.R_read} \
            -sreverse2 \
            -outseq {output.fasta} \
            -outfile {output.report}
        """


rule consensus_aggregate:
    input:
        reports = expand(os.path.join(CONSENSUS_REPORT_DIR, "{sample}_consensus_report.txt"),
                        sample = unique_samples)
    output:
        summary = os.path.join(SUMMARY_DIR, "consensus_summary.tsv")
    script:
        "scripts/consensus_aggregate.py"


rule blast:
    input:
        fasta = os.path.join(CONSENSUS_DIR, "{sample}_consensus.fasta")
    output:
        xml = os.path.join(BLAST_RAW_DIR, "{sample}_blast.xml")
    retries: 4
    params:
        blast_db = config["parameters"]["blast_database"]        
    resources:
        ncbi_connection = 1
    shell:
        """
        blastn \
        -db {params.blast_db} \
        -remote \
        -query {input.fasta} \
        -out {output.xml} \
        -outfmt 5
        """

rule final_report:
    input: 
        xmls = expand(os.path.join(BLAST_RAW_DIR, "{sample}_blast.xml"), sample=unique_samples),
        trim_summary = os.path.join(SUMMARY_DIR, "trim_metrics.tsv"),
        consensus_summary = os.path.join(SUMMARY_DIR, "consensus_summary.tsv"),
        fastas = expand(os.path.join(CONSENSUS_DIR, "{sample}_consensus.fasta"), sample=unique_samples)
    output: 
        report = os.path.join(SUMMARY_DIR, "final_report.xlsx")
    params:
        id_thresh = config["parameters"]["identity_threshold"],
        good_consensus_score = config["parameters"]["good_consensus_score"],
        max_excel_hits = config["parameters"]["max_excel_hits"],
        min_consensus_len = config["parameters"]["min_consensus_len"],
        min_coverage = config["parameters"]["min_coverage"],
        max_ambiguous_bases = config["parameters"]["max_ambiguous_bases"],
        remove_tokens_for_consensus = config.get("sample_grouping", {}).get("remove_tokens_for_consensus", [])
    script:
        "scripts/final_report.py"


